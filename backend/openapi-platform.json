{
  "openapi": "3.1.0",
  "info": {
    "title": "Chatbot Ingenius 360 — API de plataforma",
    "version": "0.1.0",
    "description": "Alta de tenants y credenciales del widget de cada clinica. Autenticada con un bearer JWT del proveedor de identidad con rol `platform`."
  },
  "servers": [
    {
      "url": "/api/platform/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "platformBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthorized",
                  "forbidden",
                  "not_found",
                  "validation_failed",
                  "conflict",
                  "method_not_allowed",
                  "rate_limited",
                  "widget_not_configured",
                  "identity_unavailable",
                  "invalid_request",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "data",
          "next_cursor"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {}
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Tenant": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WidgetClientRequest": {
        "type": "object",
        "required": [
          "client_id",
          "client_secret"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "client_secret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Se guarda sellado; nunca se devuelve ni se audita."
          }
        }
      },
      "WidgetClientSet": {
        "type": "object",
        "required": [
          "client_id",
          "updated_at"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WidgetClientRef": {
        "type": "object",
        "required": [
          "client_id"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          }
        }
      },
      "TenantRequest": {
        "type": "object",
        "required": [
          "slug",
          "name"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,48}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "allowed_origins": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "widget_client": {
            "$ref": "#/components/schemas/WidgetClientRequest",
            "description": "Credenciales del cliente OIDC del widget; se guardan en la misma transaccion."
          }
        }
      },
      "TenantCreated": {
        "type": "object",
        "required": [
          "tenant",
          "widget_key",
          "widget_client"
        ],
        "properties": {
          "tenant": {
            "$ref": "#/components/schemas/Tenant"
          },
          "widget_key": {
            "type": "string",
            "description": "Clave publica del widget (va en el HTML)."
          },
          "widget_client": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WidgetClientRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "Solo el `client_id`; el secreto nunca se devuelve."
          }
        }
      }
    }
  },
  "paths": {
    "/tenants": {
      "get": {
        "operationId": "listTenants",
        "security": [
          {
            "platformBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Identificador de correlacion. Si no viene, el servicio genera uno.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "validation_failed",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "identity_unavailable",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTenant",
        "description": "Alta con predeterminados: bot-config, KB de ejemplo y primera clave del widget. Una repeticion con la misma Idempotency-Key devuelve la respuesta original, con la widget_key emitida en el alta aunque despues se haya rotado.",
        "security": [
          {
            "platformBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Identificador de correlacion. Si no viene, el servicio genera uno.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TenantRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creado",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantCreated"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "conflict",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "validation_failed",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "identity_unavailable",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tenants/{id}/widget-client": {
      "put": {
        "operationId": "setWidgetClient",
        "description": "Registra o rota las credenciales del cliente OIDC del widget de la clinica. Una repeticion con la misma Idempotency-Key y el mismo cuerpo repite la respuesta.",
        "security": [
          {
            "platformBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Identificador de correlacion. Si no viene, el servicio genera uno.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WidgetClientRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetClientSet"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "conflict",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "validation_failed",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "identity_unavailable",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
