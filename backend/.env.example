DATABASE_URL=postgresql://ingenius:ingenius@localhost:5432/ingenius?schema=public
APP_TIMEZONE=America/Bogota
NODE_ENV=development
# Identidad: proveedor OIDC externo (el backend solo verifica tokens RS256/ES256)
OIDC_ISSUER=https://idp.ejemplo.com/realms/chatbot
OIDC_AUDIENCE=chatbot-api
# Opcionales (valores por defecto):
# OIDC_TENANT_CLAIM=tenant_id
# OIDC_ROLES_CLAIM=roles
# OIDC_ROLE_MAP=
# OIDC_CLOCK_TOLERANCE_SECONDS=30
# OIDC_LOGOUT_AUDIENCES=
# OIDC_MAX_TOKEN_LIFETIME_SECONDS=300
# 32 bytes aleatorios en base64: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Solo con HERMES_SIMULATOR_ENABLED=true. JSON {"<tenant_id>"|"*": {"client_id": "...", "client_secret": "..."}}
HERMES_SIM_SERVICE_CLIENTS=
# true detras de un proxy propio (Traefik) para que el rate limit use X-Forwarded-For
TRUST_PROXY=false
# Base publica de /fhir (URL absoluta http(s) con /fhir, p. ej. https://api.clinica.com/fhir).
# Obligatoria si HERMES_SIMULATOR_ENABLED=true y FHIR_GATEWAY=fetch (hermes:sync y la bandeja).
# Vacia y con el simulador apagado: los enlaces del Bundle usan el origen de la peticion.
FHIR_BASE_URL=
# fetch (proceso y hermes:sync) o handlers (pruebas, sin puerto). Por defecto fetch.
FHIR_GATEWAY=fetch

# Base de pruebas para las suites contra Postgres (npm run test:db)
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/chatbot_test

# Simulador de Hermes (apagado en produccion)
HERMES_SIMULATOR_ENABLED=false
