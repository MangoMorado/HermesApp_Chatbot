{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": false,
  "extends": "//",
  "overrides": [
    {
      "includes": ["src/modules/*/domain/**", "src/modules/*/application/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["next", "next/*", "@prisma/client", "node:*", "react", "react-dom"],
                    "message": "Frontera hexagonal: domain y application no pueden depender de framework, ORM ni node:*. Usa un puerto."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
