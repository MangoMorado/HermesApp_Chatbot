{
  "openapi": "3.1.0",
  "info": {
    "title": "Chatbot Ingenius 360 — API REST",
    "version": "0.1.0",
    "description": "Superficie REST para widget, panel y chat. La integracion con Hermes vive en /fhir y no se describe aqui: usa OperationOutcome, no esta envoltura de errores."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "request_id"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthorized",
                  "forbidden",
                  "not_found",
                  "validation_failed",
                  "method_not_allowed",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status", "checkedAt"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Identity": {
        "type": "object",
        "required": ["subject", "tenant_id", "role"],
        "properties": {
          "subject": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["widget", "operator", "admin", "service"]
          },
          "session_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Comprueba que el servicio responde",
        "security": [],
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Identificador de correlacion. Si no viene, el servicio genera uno.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "El servicio responde",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getIdentity",
        "summary": "Identidad efectiva del token",
        "description": "El tenant sale del claim del token, nunca de la peticion.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Identificador de correlacion. Si no viene, el servicio genera uno.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Identidad del portador",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlacion de esta peticion.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
