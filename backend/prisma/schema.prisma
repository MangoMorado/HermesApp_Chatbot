// Adaptador de persistencia del dia 1. El dominio no conoce este archivo:
// habla con puertos y la implementacion Prisma vive en infrastructure/.
// La URL de conexion vive en prisma.config.ts (Prisma 7 la saco del schema).
// Aislamiento por tenant reforzado en la base: toda referencia entre tablas de
// dominio es una FK compuesta (tenant_id, id), asi que no puede cruzar tenants.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "hermes_sim"]
}

enum SlotStatus {
  free
  busy
  busy_tentative
  busy_unavailable

  @@map("slot_status")
  @@schema("public")
}

enum MedicalRecordStatus {
  active
  pre_registered

  @@map("medical_record_status")
  @@schema("public")
}

enum AppointmentStatus {
  booked
  cancelled
  fulfilled
  noshow

  @@map("appointment_status")
  @@schema("public")
}

enum DocumentType {
  CC
  TI
  CE
  PA
  RC

  @@map("document_type")
  @@schema("public")
}

enum AppointmentRequestKind {
  book
  reschedule
  cancel

  @@map("appointment_request_kind")
  @@schema("public")
}

enum AppointmentRequestStatus {
  pending
  approved
  rejected
  expired

  @@map("appointment_request_status")
  @@schema("public")
}

enum ResolutionReason {
  slot_unavailable
  declined

  @@map("resolution_reason")
  @@schema("public")
}

enum ConversationMessageAuthor {
  bot
  patient

  @@map("conversation_message_author")
  @@schema("public")
}

enum HandoffReason {
  requested
  verification_locked
  unverifiable

  @@map("handoff_reason")
  @@schema("public")
}

enum HandoffStatus {
  open

  @@map("handoff_status")
  @@schema("public")
}

model Tenant {
  id                String   @id
  slug              String   @unique
  name              String
  maxQueryRangeDays Int      @default(31) @map("max_query_range_days")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  practitioners          Practitioner[]
  healthcareServices     HealthcareService[]
  schedules              Schedule[]
  slots                  Slot[]
  medicalRecords         MedicalRecord[]
  appointments           Appointment[]
  appointmentRequests    AppointmentRequest[]
  auditEvents            AuditEvent[]
  idempotencyKeys        IdempotencyKey[]
  botConfig              BotConfig?
  widgetKeys             WidgetKey[]
  knowledgeEntries       KnowledgeEntry[]
  widgetSessions         WidgetSession[]
  conversations          Conversation[]
  conversationMessages   ConversationMessage[]
  verificationChallenges VerificationChallenge[]
  handoffTickets         HandoffTicket[]

  @@map("tenants")
  @@schema("public")
}

model Practitioner {
  id               String   @id
  tenantId         String   @map("tenant_id")
  identifierSystem String   @map("identifier_system")
  identifierValue  String   @map("identifier_value")
  name             String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  schedules Schedule[]

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@map("practitioners")
  @@schema("public")
}

model HealthcareService {
  id               String   @id
  tenantId         String   @map("tenant_id")
  identifierSystem String   @map("identifier_system")
  identifierValue  String   @map("identifier_value")
  name             String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  schedules Schedule[]

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@map("healthcare_services")
  @@schema("public")
}

model Schedule {
  id                  String   @id
  tenantId            String   @map("tenant_id")
  identifierSystem    String   @map("identifier_system")
  identifierValue     String   @map("identifier_value")
  practitionerId      String   @map("practitioner_id")
  healthcareServiceId String   @map("healthcare_service_id")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  practitioner      Practitioner      @relation(fields: [tenantId, practitionerId], references: [tenantId, id])
  healthcareService HealthcareService @relation(fields: [tenantId, healthcareServiceId], references: [tenantId, id])
  slots             Slot[]
  appointments      Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@map("schedules")
  @@schema("public")
}

model Slot {
  id               String     @id
  tenantId         String     @map("tenant_id")
  identifierSystem String     @map("identifier_system")
  identifierValue  String     @map("identifier_value")
  scheduleId       String     @map("schedule_id")
  startAt          DateTime   @map("start_at") @db.Timestamptz(3)
  endAt            DateTime   @map("end_at") @db.Timestamptz(3)
  status           SlotStatus @default(free)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  schedule            Schedule             @relation(fields: [tenantId, scheduleId], references: [tenantId, id])
  appointments        Appointment[]
  appointmentRequests AppointmentRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@index([tenantId, scheduleId, startAt])
  @@index([tenantId, status, startAt])
  @@map("slots")
  @@schema("public")
}

model MedicalRecord {
  id               String              @id
  tenantId         String              @map("tenant_id")
  identifierSystem String              @map("identifier_system")
  identifierValue  String              @map("identifier_value")
  documentType     DocumentType        @map("document_type")
  documentNumber   String              @map("document_number")
  givenNames       String              @map("given_names")
  familyNames      String              @map("family_names")
  birthDate        DateTime            @map("birth_date") @db.Date
  phone            String?
  email            String?
  status           MedicalRecordStatus @default(active)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  appointments           Appointment[]
  appointmentRequests    AppointmentRequest[]
  conversations          Conversation[]
  verificationChallenges VerificationChallenge[]
  handoffTickets         HandoffTicket[]

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@unique([tenantId, documentType, documentNumber])
  @@map("medical_records")
  @@schema("public")
}

model Appointment {
  id               String            @id
  tenantId         String            @map("tenant_id")
  identifierSystem String            @map("identifier_system")
  identifierValue  String            @map("identifier_value")
  medicalRecordId  String            @map("medical_record_id")
  scheduleId       String            @map("schedule_id")
  slotId           String            @map("slot_id")
  startAt          DateTime          @map("start_at") @db.Timestamptz(3)
  endAt            DateTime          @map("end_at") @db.Timestamptz(3)
  status           AppointmentStatus
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  medicalRecord MedicalRecord @relation(fields: [tenantId, medicalRecordId], references: [tenantId, id])
  schedule      Schedule      @relation(fields: [tenantId, scheduleId], references: [tenantId, id])
  slot          Slot          @relation(fields: [tenantId, slotId], references: [tenantId, id])

  changeRequests AppointmentRequest[] @relation("RequestTarget")
  originRequests AppointmentRequest[] @relation("RequestResult")

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@index([tenantId, medicalRecordId, startAt])
  @@index([tenantId, scheduleId, startAt])
  @@map("appointments")
  @@schema("public")
}

// Solicitud de agenda originada por el chatbot. La resuelve Hermes; el chatbot nunca
// confirma por su cuenta. CHECK de forma e indices unicos parciales en la migracion.
model AppointmentRequest {
  id                     String                   @id
  tenantId               String                   @map("tenant_id")
  kind                   AppointmentRequestKind
  status                 AppointmentRequestStatus @default(pending)
  medicalRecordId        String                   @map("medical_record_id")
  slotId                 String?                  @map("slot_id")
  appointmentId          String?                  @map("appointment_id")
  expiresAt              DateTime                 @map("expires_at") @db.Timestamptz(3)
  resolutionReason       ResolutionReason?        @map("resolution_reason")
  resultingAppointmentId String?                  @map("resulting_appointment_id")
  createdAt              DateTime                 @map("created_at") @db.Timestamptz(3)
  resolvedAt             DateTime?                @map("resolved_at") @db.Timestamptz(3)

  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  medicalRecord        MedicalRecord @relation(fields: [tenantId, medicalRecordId], references: [tenantId, id])
  slot                 Slot?         @relation(fields: [tenantId, slotId], references: [tenantId, id], onDelete: Restrict)
  appointment          Appointment?  @relation("RequestTarget", fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  resultingAppointment Appointment?  @relation("RequestResult", fields: [tenantId, resultingAppointmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, medicalRecordId, status])
  @@map("appointment_requests")
  @@schema("public")
}

// Registra el hecho, nunca el contenido: sin columnas de datos de la peticion.
model AuditEvent {
  id           String   @id
  tenantId     String   @map("tenant_id")
  actorSubject String   @map("actor_subject")
  actorRole    String   @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  requestId    String   @map("request_id")
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, occurredAt])
  @@map("audit_events")
  @@schema("public")
}

model IdempotencyKey {
  tenantId       String   @map("tenant_id")
  key            String
  actorSubject   String   @map("actor_subject")
  method         String
  path           String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("idempotency_keys")
  @@schema("public")
}

// Configuracion del bot por tenant. Solo guarda lo que el tenant sobrescribe:
// los predeterminados viven en el dominio (modules/bot-config/domain/bot-config.ts).
model BotConfig {
  tenantId       String   @id @map("tenant_id")
  texts          Json     @default("{}")
  params         Json     @default("{}")
  allowedOrigins String[] @default([]) @map("allowed_origins")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([allowedOrigins], type: Gin, map: "bot_configs_allowed_origins_gin")
  @@map("bot_configs")
  @@schema("public")
}

// Clave publica del widget. Una sola vigente por tenant (indice unico parcial en la migracion).
model WidgetKey {
  id         String    @id
  tenantId   String    @map("tenant_id")
  key        String    @unique
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz(3)
  graceUntil DateTime? @map("grace_until") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("widget_keys")
  @@schema("public")
}

model KnowledgeEntry {
  id        String   @id
  tenantId  String   @map("tenant_id")
  category  String
  question  String
  answer    String
  detail    String?
  keywords  String[] @default([])
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@index([tenantId, category, position])
  @@map("knowledge_entries")
  @@schema("public")
}

// Sesion del widget. Sin IP: solo vive en memoria para el rate limit.
model WidgetSession {
  id         String   @id
  tenantId   String   @map("tenant_id")
  origin     String
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  conversation Conversation?

  @@unique([tenantId, id])
  @@map("widget_sessions")
  @@schema("public")
}

// Conversacion del widget: una por sesion. `context` nunca guarda respuestas de
// verificacion (GOBERNANZA §1.5); el borrador del pre-registro se borra al confirmar.
model Conversation {
  id              String   @id
  tenantId        String   @map("tenant_id")
  widgetSessionId String   @map("widget_session_id")
  step            String
  context         Json     @default("{}")
  medicalRecordId String?  @map("medical_record_id")
  messageCount    Int      @default(0) @map("message_count")
  createdAt       DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  widgetSession  WidgetSession         @relation(fields: [tenantId, widgetSessionId], references: [tenantId, id])
  medicalRecord  MedicalRecord?        @relation(fields: [tenantId, medicalRecordId], references: [tenantId, id], onDelete: Restrict)
  messages       ConversationMessage[]
  handoffTickets HandoffTicket[]

  @@unique([tenantId, id])
  @@unique([tenantId, widgetSessionId])
  @@map("conversations")
  @@schema("public")
}

// Historial. Un mensaje redactado guarda solo "[redactado]" (CHECK en la migracion).
model ConversationMessage {
  id             String                    @id
  tenantId       String                    @map("tenant_id")
  conversationId String                    @map("conversation_id")
  seq            Int
  author         ConversationMessageAuthor
  text           String
  redacted       Boolean                   @default(false)
  createdAt      DateTime                  @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, conversationId, seq])
  @@map("conversation_messages")
  @@schema("public")
}

// Par fijo de preguntas por expediente y contador de fallos. Nunca guarda respuestas.
model VerificationChallenge {
  id              String    @id
  tenantId        String    @map("tenant_id")
  medicalRecordId String    @map("medical_record_id")
  questionIds     String[]  @map("question_ids")
  failedAttempts  Int       @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  medicalRecord MedicalRecord @relation(fields: [tenantId, medicalRecordId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, medicalRecordId])
  @@map("verification_challenges")
  @@schema("public")
}

// Solo creacion en la 3.3; lectura y gestion en la Fase 5.
model HandoffTicket {
  id              String        @id
  tenantId        String        @map("tenant_id")
  conversationId  String        @map("conversation_id")
  reason          HandoffReason
  status          HandoffStatus @default(open)
  medicalRecordId String?       @map("medical_record_id")
  createdAt       DateTime      @map("created_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversation  Conversation   @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  medicalRecord MedicalRecord? @relation(fields: [tenantId, medicalRecordId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@map("handoff_tickets")
  @@schema("public")
}

// Idempotencia de la superficie de plataforma: sin tenant, porque el alta lo crea.
model PlatformIdempotencyKey {
  key            String   @id
  method         String
  path           String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  @@map("platform_idempotency_keys")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Simulador de Hermes. Schema propio, sin FKs hacia public: en produccion se
// elimina completo. tenant_id es texto: el simulador conoce el tenant como
// lo haria Hermes, sin depender de las tablas del chatbot.
// ---------------------------------------------------------------------------

enum SimSlotStatus {
  free
  busy
  busy_tentative
  busy_unavailable

  @@map("slot_status")
  @@schema("hermes_sim")
}

enum SimPatientStatus {
  active
  pre_registered

  @@map("patient_status")
  @@schema("hermes_sim")
}

enum SimAppointmentStatus {
  booked
  cancelled
  fulfilled
  noshow

  @@map("appointment_status")
  @@schema("hermes_sim")
}

enum SimDocumentType {
  CC
  TI
  CE
  PA
  RC

  @@map("document_type")
  @@schema("hermes_sim")
}

model SimPractitioner {
  id               String   @id
  tenantId         String   @map("tenant_id")
  identifierSystem String   @map("identifier_system")
  identifierValue  String   @map("identifier_value")
  name             String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  schedules SimSchedule[]

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@map("practitioners")
  @@schema("hermes_sim")
}

model SimHealthcareService {
  id               String   @id
  tenantId         String   @map("tenant_id")
  identifierSystem String   @map("identifier_system")
  identifierValue  String   @map("identifier_value")
  name             String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  schedules SimSchedule[]

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@map("healthcare_services")
  @@schema("hermes_sim")
}

model SimSchedule {
  id                  String   @id
  tenantId            String   @map("tenant_id")
  identifierSystem    String   @map("identifier_system")
  identifierValue     String   @map("identifier_value")
  practitionerId      String   @map("practitioner_id")
  healthcareServiceId String   @map("healthcare_service_id")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  practitioner      SimPractitioner      @relation(fields: [tenantId, practitionerId], references: [tenantId, id])
  healthcareService SimHealthcareService @relation(fields: [tenantId, healthcareServiceId], references: [tenantId, id])
  slots             SimSlot[]
  appointments      SimAppointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@map("schedules")
  @@schema("hermes_sim")
}

model SimSlot {
  id               String        @id
  tenantId         String        @map("tenant_id")
  identifierSystem String        @map("identifier_system")
  identifierValue  String        @map("identifier_value")
  scheduleId       String        @map("schedule_id")
  startAt          DateTime      @map("start_at") @db.Timestamptz(3)
  endAt            DateTime      @map("end_at") @db.Timestamptz(3)
  status           SimSlotStatus @default(free)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  schedule     SimSchedule      @relation(fields: [tenantId, scheduleId], references: [tenantId, id])
  appointments SimAppointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@index([tenantId, scheduleId, startAt])
  @@map("slots")
  @@schema("hermes_sim")
}

model SimPatient {
  id               String           @id
  tenantId         String           @map("tenant_id")
  identifierSystem String           @map("identifier_system")
  identifierValue  String           @map("identifier_value")
  documentType     SimDocumentType  @map("document_type")
  documentNumber   String           @map("document_number")
  givenNames       String           @map("given_names")
  familyNames      String           @map("family_names")
  birthDate        DateTime         @map("birth_date") @db.Date
  phone            String?
  email            String?
  status           SimPatientStatus @default(active)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointments SimAppointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, identifierSystem, identifierValue])
  @@unique([tenantId, documentType, documentNumber])
  @@map("patients")
  @@schema("hermes_sim")
}

model SimAppointment {
  id               String               @id
  tenantId         String               @map("tenant_id")
  identifierSystem String               @map("identifier_system")
  identifierValue  String               @map("identifier_value")
  patientId        String               @map("patient_id")
  scheduleId       String               @map("schedule_id")
  slotId           String               @map("slot_id")
  startAt          DateTime             @map("start_at") @db.Timestamptz(3)
  endAt            DateTime             @map("end_at") @db.Timestamptz(3)
  status           SimAppointmentStatus
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient  SimPatient  @relation(fields: [tenantId, patientId], references: [tenantId, id])
  schedule SimSchedule @relation(fields: [tenantId, scheduleId], references: [tenantId, id])
  slot     SimSlot     @relation(fields: [tenantId, slotId], references: [tenantId, id])

  @@unique([tenantId, identifierSystem, identifierValue])
  @@index([tenantId, patientId, startAt])
  @@map("appointments")
  @@schema("hermes_sim")
}
