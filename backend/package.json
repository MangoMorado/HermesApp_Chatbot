{
  "name": "@ingenius/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage && node ../scripts/fix-lcov-for-sonar.mjs coverage/lcov.info backend/",
    "test:db": "vitest run --project db",
    "test:db:coverage": "vitest run --project db --coverage --coverage.reportsDirectory=./coverage-db",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:pg:start": "scripts\\pg-start.cmd",
    "db:pg:stop": "scripts\\pg-stop.cmd",
    "db:pg:status": "scripts\\pg-status.cmd",
    "demo": "tsx scripts/demo.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "hermes:sync": "tsx scripts/hermes-sync.ts",
    "idp:lab": "tsx scripts/idp-lab/index.ts",
    "postman:generate": "tsx scripts/postman/generate.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "jose": "^6.2.17",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-dist": "^5.34.1",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
