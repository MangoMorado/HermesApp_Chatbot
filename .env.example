# Copiar a .env y ajustar. Ningun valor real se versiona.

# Postgres (compose lo usa para levantar la base y para DATABASE_URL)
POSTGRES_USER=ingenius
POSTGRES_PASSWORD=ingenius
POSTGRES_DB=ingenius

# Backend
DATABASE_URL=postgresql://ingenius:ingenius@localhost:5432/ingenius?schema=public
APP_TIMEZONE=America/Bogota
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
