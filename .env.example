# Copiar a .env y ajustar. Ningun valor real se versiona.

# Postgres (compose lo usa para levantar la base y para DATABASE_URL)
POSTGRES_USER=ingenius
POSTGRES_PASSWORD=ingenius
POSTGRES_DB=ingenius

# Backend
DATABASE_URL=postgresql://ingenius:ingenius@localhost:5432/ingenius?schema=public
APP_TIMEZONE=America/Bogota
NODE_ENV=development

JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_ISSUER=chatbot-ingenius-360
JWT_AUDIENCE=chatbot-ingenius-360

# Superficie de plataforma (alta de tenants y emision de tokens). >= 32 caracteres.
# Vacio: /api/platform/v1 responde 404.
PLATFORM_SECRET=
# true detras de un proxy propio (Traefik) para que el rate limit use X-Forwarded-For
TRUST_PROXY=false

# Frontend
BACKEND_URL=http://localhost:3001
