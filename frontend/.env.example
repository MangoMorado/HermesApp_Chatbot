# Leída en runtime por el proxy /api/* (no se hornea en el build).
BACKEND_URL=http://localhost:3001
# URL del backend alcanzable desde el navegador: el widget del chat habla directo con él.
PUBLIC_BACKEND_URL=http://localhost:3001
# Proveedor de identidad de la consola (login con PKCE). Se leen en runtime, no en el build.
PUBLIC_OIDC_ISSUER=https://keycloak.mangomorado.com/realms/chatbot-lab
PUBLIC_OIDC_CLIENT_ID=chatbot-reference-ui
