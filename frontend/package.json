{
  "name": "@ingenius/frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run build:widget && next dev --port 3000",
    "build": "npm run build:widget && next build",
    "build:widget": "node scripts/build-widget.mjs",
    "host:demo": "node scripts/serve-host.mjs",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node ../scripts/fix-lcov-for-sonar.mjs coverage/lcov.info frontend/",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "doctor": "react-doctor .",
    "api:generate": "orval"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "next": "^16.4.5",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "orval": "^8.47.0",
    "react-doctor": "^0.9.22",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
